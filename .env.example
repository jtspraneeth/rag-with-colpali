# Adaptive Multimodal RAG Configuration

# LLM Configuration
# Provider options: "gemini", "mistral", "openai", "ollama", "mock"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Embedding Model & Vector DB
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db

# Reranker Model
RERANKER_MODEL_NAME=ms-marco-MiniLM-L-6-v2

# Retrieval Weights & Parameters
DENSE_WEIGHT=0.4
BM25_WEIGHT=0.3
COLPALI_WEIGHT=0.3
TOP_K_CANDIDATES=20
FINAL_TOP_K=5

# Confidence & Self-Correction
CONFIDENCE_THRESHOLD=0.75
MAX_RETRIES=2

# ColPali Visual Retrieval Settings
ENABLE_COLPALI=true
COLPALI_MODEL_NAME=vidore/colpali-v1.2
FORCE_VISUAL_FALLBACK=false

# Application Settings
DEBUG_MODE=true
